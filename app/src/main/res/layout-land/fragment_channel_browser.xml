<?xml version="1.0" encoding="utf-8"?>
<!-- Browser apaisado móvil/tablet (S4): panel izquierdo 320dp (título +
     selector de playlist + rail de filtros vertical) + contenido a la derecha
     (peso 1: hero compacto + cortes + grid + vacío). Mismos ids que el
     vertical. TV prohibido (ver layout-television + escudo land-television). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/browser_title"
            android:textColor="@color/tp_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browser_list_selector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tile_focus_bg"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/tp_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browser_sidebar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clipToPadding="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/browser_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tile_focus_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/browser_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browser_hero_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/browser_hero_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100" />

            <Button
                android:id="@+id/browser_hero_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_primary"
                android:text="@string/sheet_play"
                android:textColor="@color/tp_text" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/browser_slots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browser_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/browser_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/browser_empty"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
