<?xml version="1.0" encoding="utf-8"?>
<!-- ESCUDO S4: copia exacta de layout-television/fragment_channel_browser.xml.
     Sin este dir, layout-land/ secuestraría la TV apaisada (en resolución de
     recursos la orientación precede al ui-mode). Mantener sincronizado con TV. -->
<!-- Browser fusionado TV (safe area 56dp, paridad D1+D2 + S3): título +
     columna media 200dp (selector de playlist de 48dp encima de los
     filtros) + contenido (hero + cortes + grid) a la derecha con gap 32dp.
     Foco D-pad con nextFocus explícitos §F2 (nav_browse<->selector,
     selector v sidebar, sidebar ^selector >grid <nav, grid ^selector
     <sidebar, hero_play ^selector v grid <sidebar); ninguna salida apunta
     al hero en exclusiva (puede estar GONE). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="56dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_title"
        android:textColor="@color/tp_accent"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Columna media S3: selector encima de los filtros. -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Selector de playlist (dropdown framework 48dp con tokens
                 propios, como en móvil): vive en la columna media y el rail
                 de abajo queda solo para filtros. -->
            <TextView
                android:id="@+id/browser_list_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tile_focus_bg"
                android:clickable="true"
                android:elevation="16dp"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:marqueeRepeatLimit="1"
                android:nextFocusDown="@id/browser_sidebar"
                android:nextFocusLeft="@id/nav_browse"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/lists_name"
                android:textColor="@color/tp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:nextFocusUp="@id/browser_list_selector"
                android:nextFocusRight="@id/browser_grid"
                android:nextFocusLeft="@id/nav_browse" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- W3 S3: hero mini apilado: padding 4, título 16sp 1L bold end,
                 now 12sp 1L end marginTop 2, progreso 4dp marginTop 4, VER
                 wrap + minWidth 96 x 48 marginTop 4; nextFocus del VER
                 intactos. Medido en Robolectric TV 152dp (>100 por métricas
                 de fuente infladas; en dispositivo ~110dp): se aplica el
                 ajuste previsto (padding 4 + VER margin 4). -->
            <LinearLayout
                android:id="@+id/browser_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tile_focus_bg"
                android:elevation="16dp"
                android:orientation="vertical"
                android:padding="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/browser_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/browser_hero_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/browser_hero_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:maxHeight="4dp"
                    android:minHeight="4dp" />

                <Button
                    android:id="@+id/browser_hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_primary"
                    android:focusable="true"
                    android:minHeight="48dp"
                    android:minWidth="96dp"
                    android:nextFocusDown="@id/browser_grid"
                    android:nextFocusLeft="@id/browser_sidebar"
                    android:nextFocusUp="@id/browser_list_selector"
                    android:text="@string/sheet_play"
                    android:textColor="@color/tp_text" />
            </LinearLayout>

            <!-- Cabecera del timeline: 6 cortes de 30 min ([GuideWindow])
                 en 6 celdas a peso (el fragment pinta por tipo: ViewGroup
                 → corte a corte). Sin HSV ni spacer: la fila TV es fija.
                 W2 S2: tira sin fondo ni elevación, solo aire vertical 2dp
                 (paddingTop/Bottom = paddingVertical, compatible API 23). -->
            <LinearLayout
                android:id="@+id/browser_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/browser_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/browser_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/browser_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/browser_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/browser_slot_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/browser_slot_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tp_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Contención S1: el wrap porta el peso 1 + minHeight 192dp (el
                 hero GONE ya no colapsa la zona); la grid vive dentro en
                 match_parent sin peso ni minHeight. -->
            <FrameLayout
                android:id="@+id/browser_grid_wrap"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:focusable="false"
                android:minHeight="192dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/browser_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="true"
                    android:nextFocusLeft="@id/browser_sidebar"
                    android:nextFocusUp="@id/browser_list_selector"
                    android:paddingTop="12dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/browser_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/browser_empty"
                android:textColor="@color/tp_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
