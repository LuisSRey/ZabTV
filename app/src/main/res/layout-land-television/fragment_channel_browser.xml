<?xml version="1.0" encoding="utf-8"?>
<!-- ESCUDO S4: copia exacta de layout-television/fragment_channel_browser.xml.
     Sin este dir, layout-land/ secuestraría la TV apaisada (en resolución de
     recursos la orientación precede al ui-mode). Mantener sincronizado con TV. -->
<!-- Browser fusionado TV (safe area 56dp, paridad D1+D2 + S3): título +
     columna media 200dp (selector de playlist de 48dp encima de los
     filtros) + contenido (hero + cortes + grid) a la derecha con gap 32dp.
     Foco D-pad con nextFocus explícitos §F2 (nav_browse<->selector,
     selector v sidebar, sidebar ^selector >grid <nav, grid ^selector
     <sidebar, hero_play ^selector v grid <sidebar); ninguna salida apunta
     al hero en exclusiva (puede estar GONE). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="56dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_title"
        android:textColor="@color/tp_accent"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Columna media S3: selector encima de los filtros. -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Selector de playlist (dropdown framework 48dp con tokens
                 propios, como en móvil): vive en la columna media y el rail
                 de abajo queda solo para filtros. -->
            <TextView
                android:id="@+id/browser_list_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tile_focus_bg"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:marqueeRepeatLimit="1"
                android:nextFocusDown="@id/browser_sidebar"
                android:nextFocusLeft="@id/nav_browse"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/lists_name"
                android:textColor="@color/tp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:nextFocusUp="@id/browser_list_selector"
                android:nextFocusRight="@id/browser_grid"
                android:nextFocusLeft="@id/nav_browse" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/browser_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tile_focus_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/browser_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/browser_hero_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/browser_hero_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />

                <Button
                    android:id="@+id/browser_hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:focusable="true"
                    android:nextFocusDown="@id/browser_grid"
                    android:nextFocusLeft="@id/browser_sidebar"
                    android:nextFocusUp="@id/browser_list_selector"
                    android:text="@string/sheet_play"
                    android:textColor="@color/tp_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/browser_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tp_text_secondary"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nextFocusLeft="@id/browser_sidebar"
                android:nextFocusUp="@id/browser_list_selector" />

            <TextView
                android:id="@+id/browser_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/browser_empty"
                android:textColor="@color/tp_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
