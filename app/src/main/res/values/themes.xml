<resources>
    <!-- Tema estilo Apple TV: negro puro, Inter, sin ActionBar. -->
    <style name="Theme.TVPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/tp_accent</item>
        <item name="colorAccent">@color/tp_accent</item>
        <item name="android:colorBackground">@color/tp_bg</item>
        <item name="android:windowBackground">@drawable/app_background</item>
        <item name="android:textColorPrimary">@color/tp_text</item>
        <item name="android:textColorSecondary">@color/tp_text_secondary</item>
        <item name="android:statusBarColor">@color/tp_bg</item>
        <item name="android:navigationBarColor">@color/tp_bg</item>
        <!-- Android 15+ impone edge-to-edge (fondo tras reloj/botones): no participar. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>

    <!-- Escala tipo tvOS: titulares grandes y aireados. -->
    <style name="TextAppearance_TVPlayer_HeroTitle">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/tp_text</item>
    </style>
    <style name="TextAppearance_TVPlayer_SectionTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp_text</item>
    </style>
    <style name="TextAppearance_TVPlayer_CardTitle">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tp_text</item>
    </style>
    <style name="TextAppearance_TVPlayer_Meta">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/tp_text_secondary</item>
    </style>

    <!-- Selector de playlists (S4): superficies con tokens propios — fondo
         tp_surface, texto tp_text, radio 10dp (dialog_bg), elev 8dp. -->
    <style name="ThemeOverlay.TVPlayer.ListPopup" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:popupBackground">@color/tp_surface</item>
        <item name="android:textColor">@color/tp_text</item>
        <item name="android:textColorPrimary">@color/tp_text</item>
    </style>
    <style name="ThemeOverlay.TVPlayer.ListDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColor">@color/tp_text</item>
        <item name="android:textColorPrimary">@color/tp_text</item>
    </style>
</resources>
