<?xml version="1.0" encoding="utf-8"?>
<!-- Browser fusionado (Guía→Canales): título + hero (ahora + progreso + ver)
     + selector de playlist + sidebar (Todos/Historial/grupos) + cabecera de
     cortes + grid + vacío. Móvil/tablet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_title"
        android:textColor="@color/tp_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/browser_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_focus_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/browser_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browser_hero_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance_ZabTV_Meta"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/browser_hero_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100" />

        <Button
            android:id="@+id/browser_hero_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="@string/sheet_play"
            android:textColor="@color/tp_text" />
    </LinearLayout>

    <!-- Selector de playlist en móvil (dropdown framework 48dp con tokens
         propios): el rail de abajo queda solo para filtros (Todos/Historial/
         grupos). Solo layout/ — TV prohibido. -->
    <TextView
        android:id="@+id/browser_list_selector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_focus_bg"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/lists_name"
        android:textColor="@color/tp_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/browser_sidebar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:clipToPadding="false" />

    <!-- Cabecera del timeline bajo el sidebar, encima del grid (O1: MISMO
         id que el TextView de TV: el fragment pinta por tipo, nunca con
         findViewById<TextView> directo). Spacer = offset del timeline en
         item_channel.xml móvil (ver @dimen/browser_timeline_offset) + 6
         cortes de 110dp como item_channel_timeline, envuelto en HSV.
         Hermana del hero (nunca dentro): el colapso del hero no la mueve. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/browser_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/browser_timeline_offset"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/browser_slot_0"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/browser_slot_1"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/browser_slot_2"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/browser_slot_3"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/browser_slot_4"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/browser_slot_5"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tp_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/browser_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:minHeight="96dp" />

    <TextView
        android:id="@+id/browser_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/browser_empty"
        android:textColor="@color/tp_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>
