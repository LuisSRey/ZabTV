<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/tp_accent"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_no_content"
        android:textColor="@color/tp_text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/home_add_list"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/tile_focus_bg"
        android:contentDescription="@string/lists_title"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/lists_title"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/home_browse"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_focus_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/browser_title"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/home_search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_focus_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/search_title"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/home_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_focus_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/settings_title"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <!-- Rail de favoritos (Task 9): oculto hasta haber favoritos en la primera lista. -->
    <LinearLayout
        android:id="@+id/home_favs_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fav_title"
            android:textColor="@color/tp_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_favs_rail"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
