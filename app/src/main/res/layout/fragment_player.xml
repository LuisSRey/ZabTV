<?xml version="1.0" encoding="utf-8"?>
<!-- Móvil/tablet: PlayerView (letterbox, sin deformar) + overlay inferior con logo/nombre/ahora y flechas de zapping táctil. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Atrapa-taps transparente: tocar el vídeo muestra/oculta el overlay (móvil). -->
    <View
        android:id="@+id/player_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <ProgressBar
        android:id="@+id/player_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Overlay: aparece 5 s al iniciar/cambiar canal -->
    <LinearLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_logo"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:layout_gravity="start"
            android:contentDescription="@string/player_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance_TVPlayer_HeroTitle"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/player_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Transporte: -10 s / play-pausa / +10 s -->
            <ImageView
                android:id="@+id/player_rew"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/player_seek_back"
                android:padding="8dp"
                android:src="@drawable/ic_rew" />

            <ImageView
                android:id="@+id/player_playpause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tile_focus_bg"
                android:contentDescription="@string/player_toggle"
                android:padding="10dp"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/player_ff"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/player_seek_fwd"
                android:padding="8dp"
                android:src="@drawable/ic_ff" />

            <!-- S4: reproductor externo (opt-in). En TV también existe (mismo id). -->
            <ImageView
                android:id="@+id/player_external"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/player_external"
                android:padding="8dp"
                android:src="@drawable/ic_external" />

            <!-- S3: PiP opt-in SOLO móvil (el layout TV no trae este botón; nunca auto-enter). -->
            <ImageView
                android:id="@+id/player_pip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/player_pip"
                android:padding="8dp"
                android:src="@drawable/ic_pip" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/player_zapping_hint"
                android:textColor="@color/tp_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/player_zap_down"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/player_zap_prev"
                android:src="@drawable/ic_chevron_up" />

            <ImageView
                android:id="@+id/player_zap_up"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/player_zap_next"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
