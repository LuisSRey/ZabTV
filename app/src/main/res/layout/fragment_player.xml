<?xml version="1.0" encoding="utf-8"?>
<!-- Móvil/tablet (Task 8): SurfaceView full + overlay inferior con logo/nombre/ahora y flechas de zapping táctil. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/player_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/player_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Overlay: aparece 5 s al iniciar/cambiar canal -->
    <LinearLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#880B0E14"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_logo"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:layout_gravity="start"
            android:contentDescription="@string/player_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tp_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/player_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_zap_down"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/player_zap_prev"
                android:src="@drawable/ic_chevron_up" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/player_zapping_hint"
                android:textColor="@color/tp_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/player_zap_up"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/player_zap_next"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
