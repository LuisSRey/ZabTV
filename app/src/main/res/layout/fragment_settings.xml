<?xml version="1.0" encoding="utf-8"?>
<!-- Móvil/tablet (Task 11): toggle cleartext + limpieza + acerca-de. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/tp_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settings_http"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_http"
            android:textColor="@color/tp_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_http_warn"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_wipe_favs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_wipe_favs" />

        <Button
            android:id="@+id/settings_wipe_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_epg" />

        <Button
            android:id="@+id/settings_wipe_logos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_logos" />

        <Button
            android:id="@+id/settings_wipe_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_about_title"
            android:textColor="@color/tp_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
