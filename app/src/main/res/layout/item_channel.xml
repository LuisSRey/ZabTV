<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de canal (móvil, Task 7): logo 16:9 letterbox + nombre; focus/touch = tile_focus_bg. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:contentDescription="@string/browser_channel_logo"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textAppearance="@style/TextAppearance_TVPlayer_CardTitle"
        android:textSize="13sp" />

    <!-- Tira Ahora/Siguiente (Task 14): GONE sin guía para el canal. -->
    <TextView
        android:id="@+id/channel_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/tp_accent"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
