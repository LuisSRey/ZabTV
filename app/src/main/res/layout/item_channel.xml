<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canal con timeline (fusión Guía→Canales S2): nº + logo +
     nombre/tira + 6 celdas de item_channel_timeline (scroll horizontal en
     pantallas estrechas); focus/touch = tile_focus_bg. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tp_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:contentDescription="@string/browser_channel_logo"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance_TVPlayer_CardTitle"
            android:textSize="13sp" />

        <!-- Tira Ahora/Siguiente (Task 14): GONE sin guía para el canal. -->
        <TextView
            android:id="@+id/channel_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tp_accent"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/channel_timeline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</LinearLayout>
