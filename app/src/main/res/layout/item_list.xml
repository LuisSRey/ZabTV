<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista (Task 11): nombre + subtítulo estado/canales + actualizar/borrar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/list_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/tp_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/list_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_ghost"
            android:text="@string/lists_refresh"
            android:textColor="@color/tp_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/list_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:text="@string/lists_delete"
            android:textColor="@color/tp_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/list_activate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:text="@string/lists_activate"
            android:textColor="@color/tp_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/list_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:text="@string/lists_edit"
            android:textColor="@color/tp_text"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
