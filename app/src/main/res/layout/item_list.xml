<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista: en TV la raíz NO es focable (el foco va a los botones,
     si no Actualizar/Borrar son inalcanzables con el mando); el tap abre igual. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/list_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tp_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/tp_text_secondary"
        android:textSize="13sp" />

    <!-- Scroll horizontal: en móvil estrecho caben 2 botones; el resto se desliza. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/list_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_open"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/list_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_refresh"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/list_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_delete"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/list_activate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_activate"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/list_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_edit"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/list_epg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/lists_epg"
                android:textColor="@color/tp_text"
                android:textSize="13sp" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
