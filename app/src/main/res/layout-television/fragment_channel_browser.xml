<?xml version="1.0" encoding="utf-8"?>
<!-- Browser fusionado TV (safe area 56dp, paridad D1+D2): título + selector
     de playlist (dropdown 48dp bajo el título, en la columna derecha) +
     sidebar de filtros/grupos a la izquierda (260dp) + hero con progreso +
     cabecera de cortes + filas con timeline a la derecha. Foco D-pad con
     nextFocus explícitos; ninguna salida apunta al hero (puede estar GONE). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="56dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_title"
        android:textColor="@color/tp_accent"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browser_sidebar"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:nextFocusRight="@id/browser_list_selector" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Selector de playlist (dropdown framework 48dp con tokens
                 propios, como en móvil): el rail queda solo para filtros. -->
            <TextView
                android:id="@+id/browser_list_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tile_focus_bg"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:nextFocusDown="@id/browser_grid"
                android:nextFocusLeft="@id/browser_sidebar"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/lists_name"
                android:textColor="@color/tp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/browser_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tile_focus_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/browser_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/browser_hero_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/browser_hero_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />

                <Button
                    android:id="@+id/browser_hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:focusable="true"
                    android:nextFocusDown="@id/browser_grid"
                    android:nextFocusLeft="@id/browser_sidebar"
                    android:nextFocusUp="@id/browser_list_selector"
                    android:text="@string/sheet_play"
                    android:textColor="@color/tp_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/browser_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tp_text_secondary"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nextFocusLeft="@id/browser_sidebar"
                android:nextFocusUp="@id/browser_list_selector" />

            <TextView
                android:id="@+id/browser_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/browser_empty"
                android:textColor="@color/tp_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
