<?xml version="1.0" encoding="utf-8"?>
<!-- TV: PlayerView (letterbox, sin deformar); overlay inferior grande con foco D-pad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tp_bg"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Atrapa-taps transparente: tocar el vídeo muestra/oculta el overlay. -->
    <View
        android:id="@+id/player_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <ProgressBar
        android:id="@+id/player_progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="56dp"
        android:background="@drawable/player_scrim"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_logo"
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:contentDescription="@string/player_logo"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance_TVPlayer_HeroTitle"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/player_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance_TVPlayer_Meta"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_rew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/tile_focus_bg"
                android:contentDescription="@string/player_seek_back"
                android:focusable="true"
                android:nextFocusRight="@+id/player_playpause"
                android:padding="10dp"
                android:src="@drawable/ic_rew" />

            <ImageView
                android:id="@+id/player_playpause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tile_focus_bg"
                android:contentDescription="@string/player_toggle"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_rew"
                android:nextFocusRight="@+id/player_ff"
                android:padding="12dp"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/player_ff"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/tile_focus_bg"
                android:contentDescription="@string/player_seek_fwd"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_playpause"
                android:nextFocusRight="@+id/player_external"
                android:padding="10dp"
                android:src="@drawable/ic_ff" />

            <!-- S4: reproductor externo (opt-in). -->
            <ImageView
                android:id="@+id/player_external"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tile_focus_bg"
                android:contentDescription="@string/player_external"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_ff"
                android:padding="10dp"
                android:src="@drawable/ic_external" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/player_zapping_hint_tv"
                android:textColor="@color/tp_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
