<?xml version="1.0" encoding="utf-8"?>
<!-- TV estilo app tvOS: hero panorámico + estanterías, safe area 56dp. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="56dp">

        <FrameLayout
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@drawable/tile_focus_bg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hero_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/browser_channel_logo"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/tp_scrim_dark"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance_ZabTV_HeroTitle" />

                <TextView
                    android:id="@+id/hero_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance_ZabTV_Meta"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/hero_play"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/sheet_play"
                    android:textColor="@color/tp_text" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/home_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_no_content"
            android:textColor="@color/tp_text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_favs_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fav_title"
                android:textAppearance="@style/TextAppearance_ZabTV_SectionTitle"
                android:textSize="24sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_favs_rail"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="16dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_lists_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lists_title"
                android:textAppearance="@style/TextAppearance_ZabTV_SectionTitle"
                android:textSize="24sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_lists_rail"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:clipToPadding="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
