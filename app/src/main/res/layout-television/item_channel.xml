<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de canal (TV, Task 7): tipografía y logo mayores; el foco D-pad la escala 1.1 con FocusScaleHelper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_margin="6dp"
        android:contentDescription="@string/browser_channel_logo"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/tp_text"
        android:textSize="15sp" />

    <!-- Tira Ahora/Siguiente (Task 14): GONE sin guía para el canal. -->
    <TextView
        android:id="@+id/channel_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/tp_accent"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
