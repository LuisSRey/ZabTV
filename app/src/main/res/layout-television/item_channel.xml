<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canal con timeline (TV, paridad D1+D2): cabecera con nº + logo
     96x56 + nombre/tira + tira channel_timeline horizontal de 60dp abajo con
     6 celdas de item_channel_timeline (0dp/weight1, sin scroll: caben a peso
     igual). Raíz vertical focable tile_focus_bg; el adapter se reutiliza
     intacto (infla 6 vía DEFAULT_SLOT_COUNT) y pinta Sin datos sin guía. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/tile_focus_bg"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/tp_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="96dp"
            android:layout_height="56dp"
            android:contentDescription="@string/browser_channel_logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance_TVPlayer_CardTitle"
                android:textSize="16sp" />

            <!-- Tira Ahora/Siguiente: GONE sin guía para el canal. -->
            <TextView
                android:id="@+id/channel_epg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/tp_accent"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/channel_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</LinearLayout>
