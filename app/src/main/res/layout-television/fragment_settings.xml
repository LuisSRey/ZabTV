<?xml version="1.0" encoding="utf-8"?>
<!-- TV (Task 11): safe area + toggle cleartext + limpieza + acerca-de. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/tp_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settings_http"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_http"
            android:textColor="@color/tp_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_http_warn"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settings_wipe_favs"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_wipe_favs" />

        <Button
            android:id="@+id/settings_wipe_epg"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_epg" />

        <Button
            android:id="@+id/settings_wipe_logos"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_logos" />

        <Button
            android:id="@+id/settings_wipe_all"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_buffer_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/settings_buffer_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tile_focus_bg"
                android:focusable="true"
                android:hint="@string/settings_buffer_min"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="@color/tp_text"
                android:textColorHint="@color/tp_text_secondary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/settings_buffer_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/tile_focus_bg"
                android:focusable="true"
                android:hint="@string/settings_buffer_max"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="@color/tp_text"
                android:textColorHint="@color/tp_text_secondary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/settings_buffer_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/tile_focus_bg"
                android:focusable="true"
                android:hint="@string/settings_buffer_back"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="@color/tp_text"
                android:textColorHint="@color/tp_text_secondary"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_buffer_hint"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settings_buffer_save"
            android:background="@drawable/btn_primary"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_buffer_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_about_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
