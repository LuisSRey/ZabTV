<?xml version="1.0" encoding="utf-8"?>
<!-- TV (Task 11): safe area + toggle cleartext + limpieza + acerca-de. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/tp_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_wipe_favs"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_wipe_favs" />

        <Button
            android:id="@+id/settings_wipe_epg"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_epg" />

        <Button
            android:id="@+id/settings_wipe_logos"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_logos" />

        <Button
            android:id="@+id/settings_wipe_all"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_wipe_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_buffer_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_buffer_min_label"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/settings_buffer_min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_buffer_min"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_buffer_why_min"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_buffer_max_label"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/settings_buffer_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_buffer_max"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_buffer_why_max"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_buffer_back_label"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/settings_buffer_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_buffer_back"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_buffer_why_back"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settings_buffer_save"
            android:background="@drawable/btn_primary"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_buffer_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_proxy_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settings_proxy_enable"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="@string/settings_proxy_enable"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/settings_proxy_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_proxy_host"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/settings_proxy_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_proxy_port"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/settings_proxy_type"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:entries="@array/proxy_types"
            android:focusable="true" />

        <EditText
            android:id="@+id/settings_proxy_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_proxy_user"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/settings_proxy_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_proxy_pass"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/settings_proxy_test_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_proxy_test_url"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/settings_proxy_test"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_proxy_test" />

        <TextView
            android:id="@+id/settings_proxy_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/settings_proxy_save"
            android:background="@drawable/btn_primary"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_proxy_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_proxy_bypass_warn"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_doh_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settings_doh_mode"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:entries="@array/doh_modes"
            android:focusable="true" />

        <EditText
            android:id="@+id/settings_doh_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile_focus_bg"
            android:focusable="true"
            android:hint="@string/settings_doh_custom_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="@color/tp_text"
            android:textColorHint="@color/tp_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/settings_doh_save"
            android:background="@drawable/btn_primary"
            android:textColor="@color/tp_text"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_doh_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_doh_warn"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_external_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settings_external_global"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="@string/settings_external_global"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/settings_external_player_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_external_player"
            android:textColor="@color/tp_text"
            android:textSize="17sp" />

        <Spinner
            android:id="@+id/settings_external_player"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="true" />

        <TextView
            android:id="@+id/settings_external_player_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_external_empty"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/external_nowarn"
            android:textColor="@color/tp_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_about_title"
            android:textColor="@color/tp_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
