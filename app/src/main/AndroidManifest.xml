<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Navegador local de .m3u (ruling usuario): solo API ≤29; en 30+ el
         permiso no da acceso a .m3u ajenos y no se declara. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Visibilidad de paquetes (Android 11+): sin esto la app no ve ni puede
         abrir AceStream, y el auto-arranque del motor falla en silencio. -->
    <queries>
        <package android:name="org.free.aceserve" />
        <package android:name="org.acestream.media" />
        <package android:name="org.acestream.media.atv" />
        <package android:name="org.acestream.core" />
        <package android:name="org.acestream.core.atv" />
        <package android:name="org.acestream.engine" />
        <package android:name="org.acestream.node" />
        <package android:name="org.acestream.node.web" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="acestream" />
        </intent>
        <!-- Descubrimiento del servicio del motor (arranque sin UI, vía oficial). -->
        <intent>
            <action android:name="org.acestream.engine.service.v0.IAceStreamEngine" />
        </intent>
        <!-- S4: resolución de reproductores externos (VIEW http/https). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Selector de reproductor preferido: handlers reales de vídeo
             (Android 11+ oculta sin esto la detección por mimeType). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent>
        <!-- Handlers externos HLS/DASH que filtran por mimeType (S1, auto-route):
             sin estos intents Android 11+ los oculta y el route cae a "sin app". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="application/dash+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="application/dash+xml" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".TpApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:theme="@style/Theme.TVPlayer">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Abrir con" .m3u desde gestores sin picker (Fire TV): -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.m3u" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.m3u8" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="audio/mpegurl" />
            </intent-filter>
        </activity>

    </application>
</manifest>
